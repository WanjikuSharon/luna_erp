/**
 * @fileoverview Firestore Security Rules for the inventory management application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of user-ownership and shared-access models.
 * User profiles and related data (raw material requests, delivery notes) are strictly
 * controlled by the owning user. Other collections are globally accessible, with
 * writes potentially restricted to specific roles (to be defined in later iterations).
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user themselves.
 * - /users/{userId}/raw_material_requests/{rawMaterialRequestId}: Raw material requests created by a user.
 * - /users/{userId}/delivery_notes/{deliveryNoteId}: Delivery notes uploaded by a user.
 * - /delivery_verifications/{deliveryVerificationId}: Delivery verifications, potentially accessible to admins and operation managers.
 * - /stock_updates/{stockUpdateId}: Stock updates, potentially accessible to admins and operation managers.
 * - /production_inputs/{productionInputId}: Production inputs, potentially accessible to admins and production personnel.
 * - /production_outputs/{productionOutputId}: Production outputs, potentially accessible to admins and production personnel.
 * - /inventory_discrepancies/{inventoryDiscrepancyId}: Inventory discrepancies, potentially accessible to admins and operation managers.
 *
 * Key Security Decisions:
 * - Strict user-ownership for user profiles and associated subcollections.
 * - The ruleset defaults to owner-only access unless explicitly specified otherwise.
 * - List operations are allowed for user-owned subcollections, but not for top-level collections without explicit role-based access control (future enhancement).
 * - Data validation is minimized in this prototyping phase, focusing on ownership and relationship integrity.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their own profile (user ID matches auth ID).
     * @allow (get, update, delete) - Authenticated user accesses their own profile.
     * @deny (create) - User attempts to create a profile with an ID that doesn't match their auth ID.
     * @deny (get, update, delete) - User attempts to access another user's profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if isSignedIn(); // Allow authenticated users to list all users (for admin dashboard)
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to raw material requests for a specific user.
     * @path /users/{userId}/raw_material_requests/{rawMaterialRequestId}
     * @allow (create) - Authenticated user creates a request under their own user ID.
     * @allow (get, update, delete) - Authenticated user accesses their own request.
     * @deny (create) - User attempts to create a request under another user's ID.
     * @deny (get, update, delete) - User attempts to access another user's request.
     * @principle Enforces user-ownership for raw material requests.
     */
    match /users/{userId}/raw_material_requests/{rawMaterialRequestId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to delivery notes uploaded by a specific user.
     * @path /users/{userId}/delivery_notes/{deliveryNoteId}
     * @allow (create) - Authenticated user uploads a note under their own user ID.
     * @allow (get, update, delete) - Authenticated user accesses their own note.
     * @deny (create) - User attempts to upload a note under another user's ID.
     * @deny (get, update, delete) - User attempts to access another user's note.
     * @principle Enforces user-ownership for delivery notes.
     */
    match /users/{userId}/delivery_notes/{deliveryNoteId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to delivery verifications.
     * @path /delivery_verifications/{deliveryVerificationId}
     * @allow get, list: Public read access (for now).
     * @deny create, update, delete: No unauthenticated writes.
     * @principle Allows public reads, restricts writes.
     */
    match /delivery_verifications/{deliveryVerificationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn(); // TODO: Add role-based access control.
      allow update: if isSignedIn(); // TODO: Add role-based access control.
      allow delete: if isSignedIn(); // TODO: Add role-based access control.
    }

    /**
     * @description Controls access to stock updates.
     * @path /stock_updates/{stockUpdateId}
     * @allow get, list: Public read access (for now).
     * @deny create, update, delete: No unauthenticated writes.
     * @principle Allows public reads, restricts writes.
     */
    match /stock_updates/{stockUpdateId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn(); // TODO: Add role-based access control.
      allow update: if isSignedIn(); // TODO: Add role-based access control.
      allow delete: if isSignedIn(); // TODO: Add role-based access control.
    }

    /**
     * @description Controls access to production inputs.
     * @path /production_inputs/{productionInputId}
     * @allow get, list: Public read access (for now).
     * @deny create, update, delete: No unauthenticated writes.
     * @principle Allows public reads, restricts writes.
     */
    match /production_inputs/{productionInputId} {
       function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn(); // TODO: Add role-based access control.
      allow update: if isSignedIn(); // TODO: Add role-based access control.
      allow delete: if isSignedIn(); // TODO: Add role-based access control.
    }

    /**
     * @description Controls access to production outputs.
     * @path /production_outputs/{productionOutputId}
     * @allow get, list: Public read access (for now).
     * @deny create, update, delete: No unauthenticated writes.
     * @principle Allows public reads, restricts writes.
     */
    match /production_outputs/{productionOutputId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn(); // TODO: Add role-based access control.
      allow update: if isSignedIn(); // TODO: Add role-based access control.
      allow delete: if isSignedIn(); // TODO: Add role-based access control.
    }

    /**
     * @description Controls access to inventory discrepancies.
     * @path /inventory_discrepancies/{inventoryDiscrepancyId}
     * @allow get, list: Public read access (for now).
     * @deny create, update, delete: No unauthenticated writes.
     * @principle Allows public reads, restricts writes.
     */
    match /inventory_discrepancies/{inventoryDiscrepancyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn(); // TODO: Add role-based access control.
      allow update: if isSignedIn(); // TODO: Add role-based access control.
      allow delete: if isSignedIn(); // TODO: Add role-based access control.
    }

    /**
     * @description Controls access to raw materials inventory.
     * @path /rawMaterials/{materialId}
     * @allow get, list: Authenticated users can read.
     * @allow create, update, delete: Authenticated users can write.
     * @principle Allows authenticated access to inventory data.
     */
    match /rawMaterials/{materialId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /**
     * @description Controls access to admin activities log.
     * @path /adminActivities/{activityId}
     * @allow get, list: Authenticated users can read.
     * @allow create: Authenticated users can create.
     * @principle Allows authenticated access to activity logs.
     */
    match /adminActivities/{activityId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /**
     * @description Controls access to operations activities log.
     * @path /operationsActivities/{activityId}
     * @allow get, list: Authenticated users can read.
     * @allow create: Authenticated users can create.
     * @principle Allows authenticated access to activity logs.
     */
    match /operationsActivities/{activityId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /**
     * @description Controls access to material requests.
     * @path /material_requests/{requestId}
     * @allow read, write: Authenticated users can access.
     * @principle Allows authenticated access to material requests.
     */
    match /material_requests/{requestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}